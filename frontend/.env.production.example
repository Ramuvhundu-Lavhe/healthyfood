# Set these as env vars in the Vercel dashboard (Project Settings → Environment Variables)
# VITE_API_URL: the deployed backend URL (no trailing slash), e.g. https://healthyfood-api.onrender.com
# VITE_GEMINI_API_KEY: Google AI Studio API key from https://aistudio.google.com/app/apikey
VITE_API_URL=https://YOUR-RENDER-URL.onrender.com
VITE_GEMINI_API_KEY=your_google_ai_studio_key_here
