{
  "name": "healthyfood-companion-api-backend-server",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "description": "Node backend for proxying Google Cloud API requests",
  "main": "server.js",
  "scripts": {
    "start": "node data-server.js",
    "dev": "nodemon --env-file=.env.local data-server.js",
    "proxy": "node --env-file=.env.local server.js",
    "data": "node --env-file=.env.local data-server.js",
    "data-dev": "nodemon --env-file=.env.local data-server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^0.15.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^2.7.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "nodemon": "^3.1.11"
  }
}
